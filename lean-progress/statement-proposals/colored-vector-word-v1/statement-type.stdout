∀ {C E : Type} [DecidableEq C] [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [CompleteSpace E]
  (m : C → ℕ) (K : (c : C) → Fin (m c) → E →L[ℝ] E) (c : C) (f : Poly m E),
  MemLp (signal K c ↑↑(realize f)) 2 (noise (Index m)) ∧ coordinate K c (realize f) = realize (insertCoeff K c f) : Prop
∀ {C E : Type} [DecidableEq C] [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [CompleteSpace E]
  (m : C → ℕ) (F : E →L[ℝ] E) (f : Poly m E), realize (coeffFrame F f) = F.compLp (realize f) : Prop
∀ {C B E : Type} [inst : DecidableEq C] [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℝ E]
  [inst_3 : CompleteSpace E] (m : C → ℕ) (K : (c : C) → Fin (m c) → E →L[ℝ] E) (F : B → E →L[ℝ] E) (F₀ : E →L[ℝ] E)
  (v : E) (N : C → ℕ) (w : List (C × B)) (c : C),
  MemLp (signal K c ↑↑(rawVector K F F₀ v w)) 2 (noise (Index m)) ∧
    MemLp (signal K c ↑↑((project N) (cutVector K F F₀ v N w))) 2 (noise (Index m)) : Prop
∀ {C B E : Type} [inst : DecidableEq C] [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℝ E]
  [inst_3 : CompleteSpace E] (m : C → ℕ) (K : (c : C) → Fin (m c) → E →L[ℝ] E) (F : B → E →L[ℝ] E) (F₀ : E →L[ℝ] E)
  (v : E) (N : C → ℕ) (w : List (C × B)),
  (∀ (c : C), HermiteWord.counts w c ≤ N c) → cutVector K F F₀ v N w = rawVector K F F₀ v w : Prop
