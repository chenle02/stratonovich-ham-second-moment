∀ {Mode : Type u} {E : Type v} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [inst_2 : CompleteSpace E]
  (p : (Mode →₀ ℕ) → Prop) (f : (Mode →₀ ℕ) →₀ E),
  (↑(cutoffSpace p)).starProjection (realize f) = realize (cut p f) : Prop
∀ {Color : Type w} {E : Type v} [inst : DecidableEq Color] [inst_1 : NormedAddCommGroup E]
  [inst_2 : InnerProductSpace ℝ E] [inst_3 : CompleteSpace E] (m N : Color → ℕ)
  (f : ((c : Color) × Fin (m c) →₀ ℕ) →₀ E),
  (↑(cutoffSpace (colorLow Sigma.fst N))).starProjection (realize f) = realize (cut (colorLow Sigma.fst N) f) : Prop
