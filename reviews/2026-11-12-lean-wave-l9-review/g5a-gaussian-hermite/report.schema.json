{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subscription-review-report/1",
  "type": "object",
  "required": ["schema", "verdict", "confidence", "source_coverage", "checks", "findings", "required_repairs", "limitations"],
  "properties": {
    "schema": {"const": "subscription-review-report/1"},
    "verdict": {"enum": ["PASS", "PASS_WITH_NOTES", "FAIL", "INCONCLUSIVE"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "source_coverage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["claim", "verdict", "reason"],
      "properties": {"claim": {"type": "string", "minLength": 1}, "verdict": {"enum": ["PASS", "PASS_WITH_NOTES", "FAIL", "INCONCLUSIVE", "PARTIAL"]}, "reason": {"type": "string", "minLength": 1}}}},
    "findings": {"type": "object", "required": ["fatal", "major", "minor"], "properties": {
      "fatal": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "major": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "minor": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "required_repairs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
